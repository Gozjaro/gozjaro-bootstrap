# Gozjaro LFS build environment.
# Sourced by build.sh and by the lfs user's ~/.bash_profile / ~/.bashrc.

# Use `=` (not `:=`) so an intentionally-empty LFS (inside chroot) is preserved.
: "${LFS=/mnt/lfs}"
# Toolchain triple: <arch>-<vendor>-linux-gnu. The vendor must be a SINGLE
# hyphen-free token (config.sub rejects 5-component triples like
# x86_64-gozjaro-linux-linux-gnu). Default "lfs" matches the book and every
# other stage that assumes the standard cross-target. To brand it, set
# LFS_TGT_VENDOR=gozjaro (-> x86_64-gozjaro-linux-gnu, still valid).
: "${LFS_TGT_VENDOR:=lfs}"
: "${LFS_TGT=$(uname -m)-${LFS_TGT_VENDOR}-linux-gnu}"
: "${LC_ALL:=POSIX}"

# Distro identity (used in /etc/os-release, hosts, inittab banner, etc.).
# NOT used for the toolchain triple — keep it a plain distribution ID.
DISTRO_NAME="Gozjaro"
DISTRO_ID="gozjaro-linux"
DISTRO_VERSION="26.10 alpha lfs"

# LFS book version this tree targets.
LFS_BOOK_VERSION="13.1-rc2"

# Upstream URLs used by 20-fetch-sources.sh. Refresh these from the book
# when bumping LFS_BOOK_VERSION (see README "Refreshing packages").
LFS_WGET_LIST_URL="https://www.linuxfromscratch.org/lfs/view/${LFS_BOOK_VERSION}/wget-list-sysv"
LFS_MD5_URL="https://www.linuxfromscratch.org/lfs/view/${LFS_BOOK_VERSION}/md5sums"

# Parallelism
: "${MAKEFLAGS:=-j$(nproc 2>/dev/null || echo 2)}"
: "${PARALLEL_DOWNLOADS:=4}"

# Source-mirror selection.
#   auto  (default)  Probe the mirror hosts listed in config/mirror-map.tsv
#                    once at the start of 20-fetch-sources; use them if one
#                    answers, otherwise download straight from upstream.
#   ustc             Force mirror rewrites through config/mirror-map.tsv
#                    (the name is historical: entries may point at any host).
#   direct           Never rewrite; always use upstream.
# In every mode the fetch stage falls back to the upstream URL when a mirror
# 404s or stalls, so a wrong map entry can never break a build. LFS patches
# are NOT mirrored (no LFS patch tree) and stay on linuxfromscratch.org.
: "${GOZJARO_SOURCE_MIRROR:=auto}"
: "${GOZJARO_MIRROR_MAP:=${GOZJARO_ROOT:-.}/config/mirror-map.tsv}"

# Installer release (github.com/Gozjaro/gozjaro-installer-rs), pinned two ways
# so the live ISO always ships the exact installer that was tested:
#   * source tarball  (codeload @GOZJARO_INSTALL_REF, SHA256 hard gate):
#     carries the chroot initramfs builder script that stage 77 installs
#   * release binary  (GOZJARO_INSTALL_RELEASE, _BIN_SHA256): the x86_64 ELF
#     /usr/bin/gozjaro-install, built by the repo's GHA in a debian:bullseye
#     container (glibc 2.31 == this distro's glibc)
# Stage 20 fetches both into $SOURCES_DIR; stage 77 deploys them.
GOZJARO_INSTALL_REF="ca150f09842d63e777104cbb5cab5568357dc14b"
GOZJARO_INSTALL_SHA256="6011f59fee9fcb2ded78eb9cfd39dedc02f1c2cb189ff362f1ed66fa8bcee320"
GOZJARO_INSTALL_RELEASE="installer-v1"
GOZJARO_INSTALL_BIN_SHA256="2eb2a30e01aaa0c12fc80c411076291f6e84f0c83be5e72f7ffcf35e4b20c802"

# Derived paths
STATE_DIR="${LFS}/var/gozjaro/state"
LOG_DIR="${LFS}/var/gozjaro/log"
SOURCES_DIR="${LFS}/sources"

export LFS LFS_TGT LFS_TGT_VENDOR LC_ALL MAKEFLAGS
export DISTRO_NAME DISTRO_ID DISTRO_VERSION LFS_BOOK_VERSION
export STATE_DIR LOG_DIR SOURCES_DIR
export GOZJARO_SOURCE_MIRROR GOZJARO_MIRROR_MAP
export GOZJARO_INSTALL_REF GOZJARO_INSTALL_SHA256 GOZJARO_INSTALL_RELEASE GOZJARO_INSTALL_BIN_SHA256
